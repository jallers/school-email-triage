# ==============================================================================
# School Email Triage - Configuration Template
# Copy this file to .env and insert your own API keys and family details.
# ==============================================================================

# 1. Gemini API Key (Get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 2. Gemini Model (gemini-3.5-flash-lite is fast, highly accurate, and reliable)
GEMINI_MODEL=gemini-3.5-flash-lite

# 3. Gmail Search Query (Unread school notices, district emails, Canvas, flyers)
# Example: from:(*instructure.com OR *myschooldistrict.org OR *peachjar.com) is:unread
SCHOOL_EMAIL_QUERY=from:(*instructure.com OR *schools.org OR *peachjar.com) is:unread

# 4. Gmail Labels (Organize under 'Kids/' or your preferred structure)
LABEL_PROCESSED=School/Processed
LABEL_DAUGHTER=Kids/School - Child 1
LABEL_SON=Kids/School - Child 2
LABEL_GENERAL=School/General

# Current Grades for the school year
DAUGHTER_CURRENT_GRADE=10th Grade
SON_CURRENT_GRADE=8th Grade

# 5. Google Tasks Integration (Creates action items in child-specific task lists)
SYNC_GOOGLE_TASKS=true

# 6. Local OAuth File Paths
CREDENTIALS_PATH=credentials.json
TOKEN_PATH=token.json

# 7. Family Context Hints (Helps the AI classify which child each email belongs to)
DAUGHTER_NAME=Child 1
SON_NAME=Child 2
DAUGHTER_SCHOOL=Lincoln High School
SON_SCHOOL=Oak Middle School

DAUGHTER_TEACHERS=Smith,Johnson,Davis,Miller
DAUGHTER_KEYWORDS=Biology, Geometry, World History, English, Spanish

SON_TEACHERS=Williams,Brown,Jones,Taylor
SON_KEYWORDS=Physical Science, Algebra, Earth Science, Band, Orchestra

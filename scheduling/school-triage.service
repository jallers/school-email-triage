[Unit]
Description=School Email Triage Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/school-email-triage
ExecStart=/usr/local/bin/uv run school-email-triage
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
